diff --git a/lk2nd/misc.c b/lk2nd/misc.c
new file mode 100644
index 00000000..042f31f0
--- /dev/null
+++ b/lk2nd/misc.c
@@ -0,0 +1,80 @@
+// SPDX-License-Identifier: BSD-3-Clause
+/*
+ * Reboot-into-fastboot support for lk1st.
+ *
+ * The stock lk1st (ABOOT_STANDALONE) does not compile app/aboot/recovery.c and
+ * has no check_reboot_mode() on msm8916, so a "reboot-fastboot" request from
+ * Linux cannot be honored via the standard recovery-message path. Instead we
+ * read the misc partition's recovery_message.command field directly during
+ * lk2nd_init() and force boot_into_fastboot when it says "boot-fastboot".
+ *
+ * After entering fastboot, the command field is cleared so the next normal
+ * boot proceeds without re-entering fastboot.
+ */
+
+#include <debug.h>
+#include <dev/flash.h>
+#include <partition_parser.h>
+#include <string.h>
+#include <target.h>
+
+#include <lk2nd/init.h>
+
+extern bool boot_into_fastboot;
+
+#define RECOVERY_CMD "boot-fastboot"
+#define MISC_PARTITION "misc"
+#define RECOVERY_MESSAGE_COMMAND_SIZE 32
+#define MISC_COMMAND_PAGE 1
+/* mmc_read/mmc_write require 512-byte aligned transfers and buffers, so read
+ * a whole sector even though only the first 32 bytes carry the command. */
+#define MISC_READ_SIZE 512
+
+static void lk2nd_misc_check_fastboot(void)
+{
+	int index;
+	unsigned long long offset;
+	uint32_t buf[MISC_READ_SIZE / sizeof(uint32_t)];
+
+	if (!target_is_emmc_boot())
+		return;
+
+	index = partition_get_index(MISC_PARTITION);
+	if (index == INVALID_PTN) {
+		dprintf(INFO, "lk2nd: %s partition not found\n", MISC_PARTITION);
+		return;
+	}
+	offset = partition_get_offset(index);
+
+	/* lk reads the recovery message from page 1 of misc (page 0 is
+	 * reserved for the bootloader message on some devices). MSM8916 eMMC
+	 * uses 512-byte sectors; flash_page_size() is not linked into the
+	 * lk2nd module so use the known value. */
+	offset += MISC_COMMAND_PAGE * 512;
+
+	memset(buf, 0, sizeof(buf));
+	if (mmc_read(offset, buf, sizeof(buf))) {
+		dprintf(CRITICAL, "lk2nd: failed to read %s partition\n",
+			MISC_PARTITION);
+		return;
+	}
+	buf[RECOVERY_MESSAGE_COMMAND_SIZE / sizeof(uint32_t) - 1] = 0;
+
+	if (!strcmp((const char *)buf, RECOVERY_CMD)) {
+		dprintf(INFO, "lk2nd: %s requested, entering fastboot\n",
+			RECOVERY_CMD);
+
+		/* Clear the command so the next boot is normal. The write
+		 * covers the full sector but the command bytes and the
+		 * terminating NULs are what matter. */
+		memset(buf, 0, sizeof(buf));
+		if (mmc_write(offset, sizeof(buf), buf)) {
+			dprintf(CRITICAL,
+				"lk2nd: failed to clear %s command on %s\n",
+				RECOVERY_CMD, MISC_PARTITION);
+		}
+
+		boot_into_fastboot = true;
+	}
+}
+LK2ND_INIT(lk2nd_misc_check_fastboot);
diff --git a/lk2nd/rules.mk b/lk2nd/rules.mk
index 4c0209c9..4f2f81f1 100644
--- a/lk2nd/rules.mk
+++ b/lk2nd/rules.mk
@@ -22,4 +22,5 @@ endif
 $(BUILDDIR)/$(LOCAL_DIR)/%.o: CFLAGS := $(CFLAGS) -Wmissing-prototypes
 
 OBJS += $(LOCAL_DIR)/init.o
+OBJS += $(LOCAL_DIR)/misc.o
 include $(LOCAL_DIR)/util/rules.mk
